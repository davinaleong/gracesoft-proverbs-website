---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  page?: 'privacy' | 'terms' | 'support';
}

const { title, description, page } = Astro.props;

const navLinks = [
  { href: '/privacy', label: 'Privacy', key: 'privacy' },
  { href: '/terms', label: 'Terms', key: 'terms' },
  { href: '/support', label: 'Support', key: 'support' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/logo-square.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">
          <img
            class="wordmark-logo wordmark-logo-light"
            src="/assets/wm-b.svg"
            alt="GraceSoft Proverbs"
          />
          <img
            class="wordmark-logo wordmark-logo-dark"
            src="/assets/wm-w.svg"
            alt="GraceSoft Proverbs"
          />
        </a>
        <div class="nav-actions">
          {
            navLinks.map((link) => (
              <a
                class={`nav-link${page === link.key ? ' current' : ''}`}
                href={link.href}
              >
                {link.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            id="themeToggle"
            aria-label="Toggle light and dark mode"
          >
            <svg
              id="iconSun"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.7"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap footer-inner">
        <p>&copy; 2026 GraceSoft. All five translations are in the public domain.</p>
        <div class="footer-links">
          <a href="mailto:davinaleong@gracesoft.com">Send feedback</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/support">Support</a>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('themeToggle');
      const iconSun = document.getElementById('iconSun');

      function applyTheme(mode: string) {
        root.setAttribute('data-theme', mode);
        if (!iconSun) return;
        if (mode === 'dark') {
          iconSun.innerHTML =
            '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/>';
        } else {
          iconSun.innerHTML =
            '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>';
        }
      }

      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      applyTheme(prefersDark ? 'dark' : 'light');

      toggle?.addEventListener('click', () => {
        const current = root.getAttribute('data-theme');
        applyTheme(current === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
